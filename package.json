{
    "name": "live-connector",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@10.33.3",
    "engines": {
        "node": ">=24.16.0"
    },
    "scripts": {
        "skills": "DISABLE_TELEMETRY=1 pnpm dlx skills add philtzjp/skills -a claude-code -a codex -a cursor -s github -s japanese -s turborepo -s conventions -y",
        "postinstall": "[ -n \"$CI\" ] || [ ! -e .git ] || pnpm run skills || true",
        "build": "turbo run build",
        "package": "turbo run package",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "format": "biome format --write .",
        "lint": "biome check ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.1",
        "@types/node": "^26.0.1",
        "turbo": "^2.10.0",
        "typescript": "^6.0.3"
    }
}
